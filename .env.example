# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# Vercel 에 배포할 때는 같은 값을 Settings → Environment Variables 에도 등록해야 합니다.

# ── 화면 표시 ─────────────────────────────────────────
# 홈 화면에 보일 팀 이름. 비워두면 "우리 팀 사이트"로 표시됩니다.
NEXT_PUBLIC_TEAM_NAME=1조

# ── Supabase (공지사항) ───────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
